{
  "name": "learngpt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "desktop:dev": "npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@2 build",
    "linux:build": "npx --yes @tauri-apps/cli@2 build",
    "macos:build": "npx --yes @tauri-apps/cli@2 build",
    "android:init": "npx --yes @tauri-apps/cli@2 android init --ci",
    "android:build": "npx --yes @tauri-apps/cli@2 android build --apk --aab --ci",
    "ios:init": "npx --yes @tauri-apps/cli@2 ios init --ci",
    "ios:build:simulator": "npx --yes @tauri-apps/cli@2 ios build --target aarch64-sim --ci"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "highlight.js": "^11.12.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-feather": "^2.0.10",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.16.2",
    "typescript": "^5.9.0"
  }
