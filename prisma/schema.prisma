generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  directoryId  String        @unique
  email        String        @unique
  name         String
  passwordHash String?
  provider     String?
  providerId   String?
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  chats        Chat[]
  projects     Project[]
  settings     UserSettings?
  memory       UserMemory?
  skills       UserSkill[]
  @@unique([provider, providerId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Chat {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  title     String
  pinned    Boolean   @default(false)
  isPublic  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]
  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  goal      String   @db.Text
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats     Chat[]
  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String   @db.Text
  images    Json?
  attachments Json?
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@index([chatId, createdAt])
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  name      String
  slug      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, slug])
  @@index([userId, updatedAt])
}

model GlobalMemory {
  id        String   @id
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id           String @id @default(cuid())
  userId       String @unique
  provider     String @default("gemini")
  model        String @default("learn-1.0-smart")
  theme             String  @default("dark")
  enabledSkills     Json    @default("[\"frontend-design\"]")
  webSearchEnabled  Boolean @default(false)
  speechLanguage    String  @default("auto")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
