{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnGPT",
  "version": "1.0.0",
  "identifier": "id.my.learngpt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://www.learngpt.my.id"
  },
  "app": {
    "windows": [
      {
        "title": "LearnGPT",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "learngpt-desktop"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "LearnGPT desktop app",
    "longDescription": "The LearnGPT AI learning workspace for Windows desktop.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "learngpt"
        ]
      }
    }
  }
}
