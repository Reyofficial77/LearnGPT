{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LearnGPT",
  "version": "1.0.0",
  "identifier": "id.my.learngpt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "https://www.learngpt.my.id"
  },
  "app": {
    "windows": [
      {
        "title": "LearnGPT",
        "width": 1360,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "learngpt-desktop",
        "learngpt-mobile"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "LearnGPT AI learning app",
    "longDescription": "LearnGPT AI learning workspace for Windows, macOS, Linux, iOS and Android.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "learngpt"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "learngpt"
          ],
          "appLink": false
        }
      ]
    }
  }
}
