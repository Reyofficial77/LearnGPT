{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "learngpt-desktop",
  "description": "Minimal permissions for the trusted LearnGPT web application.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://www.learngpt.my.id/**"
    ]
  },
  "permissions": [
    "core:event:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.learngpt.my.id/**"
        }
      ]
    }
  ],
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ]
}
