# PostgreSQL / Vercel Postgres or Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NOTE: AI provider keys (Gemini / OpenAI / Anthropic) are NOT configured here anymore.
# Every user adds their own key in Settings; it is stored only in their browser.

# OAuth. These are SERVER-ONLY. Do NOT use NEXT_PUBLIC_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
