# PostgreSQL / Vercel Postgres or Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Google Gemini API (Gemma 4). Server-side only; never use NEXT_PUBLIC_.
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides. Defaults:
# Learn 1.0 Smart    -> gemma-4-26b-a4b-it (thinking: minimal)
# Learn 1.0 Study    -> gemma-4-31b-it (thinking: minimal)
# Learn 2.0 Thinking -> gemma-4-31b-it (thinking: high)
# GEMINI_MODEL_SMART=gemma-4-26b-a4b-it
# GEMINI_MODEL_STUDY=gemma-4-31b-it
# GEMINI_MODEL_THINKING=gemma-4-31b-it

# OAuth. These are SERVER-ONLY. Do NOT use NEXT_PUBLIC_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public canonical URL used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=https://www.learngpt.my.id
