# OAuth public/client configuration.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Server-side GitHub OAuth exchange.
# Keep the GitHub client secret private. Do NOT prefix it with NEXT_PUBLIC_.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional server-side fallback AI API keys.
# Users can also configure provider API keys from LearnGPT Settings.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
