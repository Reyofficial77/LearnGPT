# PostgreSQL / Vercel Postgres or Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# AI provider: Ollama Cloud (server-side only, users never enter a key).
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Optional overrides (defaults shown)
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL_SMART=gemma4:31b          # Learn 1.0 Smart
# OLLAMA_MODEL_STUDY=beam                # Learn 1.0 Study
# OLLAMA_MODEL_THINKING=gpt-oss:120b   # Learn 2.0 Thinking

# OAuth. These are SERVER-ONLY. Do NOT use NEXT_PUBLIC_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public canonical URL used by metadata, sitemap, and robots. Set this to your verified production domain.
NEXT_PUBLIC_SITE_URL=https://www.learngpt.my.id
